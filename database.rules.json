      ".read": true,
      ".write": true,
      ".indexOn": ["Ma_hoa_don", "Ma_dich_vu", "Trang_thai"]
    },
    "bao_cao": {
      ".read": true,
      ".write": true,
      ".indexOn": ["Ma_hoa_don"]
    },
    "don_hang": {
      ".read": true,
      ".write": true,
      ".indexOn": ["Ma_hoa_don", "So_hoa_don", "Trang_thai"]
    },
    "live_orders": {
      ".read": true,
      ".write": true,
