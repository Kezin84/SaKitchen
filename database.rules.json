    },
    "logo": {
      ".read": true,
      ".write": true,
      ".indexOn": ["ID"]
    },
    "khuyenmai_info": {
      ".read": true,
      ".write": true,
      ".indexOn": ["ID"]
    },
    "shop_contact": {
      ".read": true,
      ".write": true,
      ".indexOn": ["ID"]
    },
    "partners": {
      ".read": true,
      ".write": true,
      ".indexOn": ["ID", "Sort_order"]
    },
    "feed_posts": {
      ".read": true,
      ".write": true,
      ".indexOn": ["ID", "Pinned", "Sort_order", "Created_at", "Post_type"]
    },
    "time": {
      ".read": true,
      ".write": true,
      ".indexOn": ["ID"]
    },
