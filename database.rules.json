      ".read": true,
      ".write": true,
      ".indexOn": ["Ma_hang", "Trang_thai"]
    },
    "khach_hang": {
      ".read": true,
      ".write": true,
      ".indexOn": ["Ma_khach_hang", "So_dien_thoai"]
    },
