{
  "name": "sakitchen",
  "main": "./worker/index.js",
  "compatibility_date": "2025-11-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/manifest.webmanifest",
      "/favicon.ico",
      "/favicon-192.png",
      "/apple-touch-icon.png",
      "/icon-192.png",
      "/icon-512.png",
      "/og-share.jpg",
      "/",
      "/vi",
      "/vi/*",
      "/en",
      "/en/*",
      "/zh-CN",
      "/zh-CN/*",
      "/fil",
      "/fil/*",
      "/ko",
      "/ko/*",
      "/welcome",
      "/blog",
      "/blog/*",
      "/sitemap.xml"
    ]
  }
}
